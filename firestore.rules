rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 3. Path Variable Hardening helper
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'rlashmi086@gmail.com' ||
        request.auth.token.email == 'admin@securepass.internal'
      );
    }

    // 2. Validation Blueprint (The "Anti-Update-Gap")
    function isValidUser(data) {
      return data.username is string && data.username.size() >= 3 && data.username.size() <= 32
          && (!('firstName' in data) || (data.firstName is string && data.firstName.size() <= 100))
          && (!('lastName' in data) || (data.lastName is string && data.lastName.size() <= 100));
    }

    function isValidMessage(data) {
      let isDemo = data.userId is string && (data.userId.matches('^sample_.*') || data.userId.matches('^demo_.*'));
      let isSelf = data.userId is string && data.userId == request.auth.uid;
      return (isSelf || isDemo)
          && data.username is string
          && data.text is string && data.text.size() > 0;
    }

    function isValidPost(data) {
      let isDemo = data.userId is string && (data.userId.matches('^sample_.*') || data.userId.matches('^demo_.*'));
      return data.userId is string && (data.userId == request.auth.uid || isDemo)
          && data.username is string && data.username.size() > 0
          && data.content is string && data.content.size() > 0 && data.content.size() <= 5000
          && (isDemo || data.createdAt <= request.time);
    }

    function isValidReply(data) {
      let isDemo = data.userId is string && (data.userId.matches('^sample_.*') || data.userId.matches('^demo_.*'));
      return data.userId is string && (data.userId == request.auth.uid || isDemo)
          && data.username is string && data.username.size() > 0
          && data.content is string && data.content.size() > 0 && data.content.size() <= 2000
          && (isDemo || data.createdAt <= request.time);
    }

    function isValidMilestone(data) {
      return data.userId is string && data.userId == request.auth.uid
          && data.milestoneId is string && data.milestoneId.size() > 0 && data.milestoneId.size() <= 100
          && data.achievedAge is number && data.achievedAge >= 0 && data.achievedAge <= 200
          && data.achievedDate is string && data.achievedDate.size() <= 50
          && (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000));
    }

    function isValidConsultation(data) {
      return data.userId is string && data.userId == request.auth.uid
          && data.doctorName is string && data.doctorName.size() > 0 && data.doctorName.size() <= 100
          && data.specialty is string && data.specialty.size() > 0 && data.specialty.size() <= 100
          && data.city is string && data.city.size() > 0 && data.city.size() <= 100
          && data.clinic is string && data.clinic.size() > 0 && data.clinic.size() <= 200
          && data.date is string && data.date.size() > 0 && data.date.size() <= 50
          && data.time is string && data.time.size() > 0 && data.time.size() <= 50
          && data.status is string && (data.status == 'confirmed' || data.status == 'pending' || data.status == 'cancelled')
          && data.createdAt <= request.time;
    }

    function isValidUserRoutine(data) {
      return (!('completedIds' in data) || (data.completedIds is list && data.completedIds.size() <= 300))
          && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 100));
    }

    function isValidAnalyticsEvent(data) {
      let allowedKeys = [
        'userId', 'visitorId', 'isReturningVisitor', 'accountType', 'entryPoint',
        'personaName', 'childProfile', 'activeTab', 'loginDate', 'dayOfWeek',
        'loginTime', 'timeOfDaySlot', 'city', 'region', 'country', 'timezone',
        'deviceType', 'browser', 'os', 'createdAtIso', 'createdAt'
      ];
      return data.keys().hasOnly(allowedKeys)
          && data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128
          && data.visitorId is string && data.visitorId.size() > 0 && data.visitorId.size() <= 128
          && data.isReturningVisitor is bool
          && data.accountType is string && data.accountType.size() > 0 && data.accountType.size() <= 60
          && data.entryPoint is string && data.entryPoint.size() > 0 && data.entryPoint.size() <= 120
          && data.personaName is string && data.personaName.size() > 0 && data.personaName.size() <= 100
          && data.childProfile is string && data.childProfile.size() > 0 && data.childProfile.size() <= 100
          && (!('activeTab' in data) || (data.activeTab is string && data.activeTab.size() <= 80))
          && data.loginDate is string && data.loginDate.size() > 0 && data.loginDate.size() <= 30
          && data.dayOfWeek is string && data.dayOfWeek.size() > 0 && data.dayOfWeek.size() <= 30
          && data.loginTime is string && data.loginTime.size() > 0 && data.loginTime.size() <= 60
          && data.timeOfDaySlot is string && data.timeOfDaySlot.size() > 0 && data.timeOfDaySlot.size() <= 60
          && data.city is string && data.city.size() > 0 && data.city.size() <= 120
          && data.region is string && data.region.size() > 0 && data.region.size() <= 120
          && data.country is string && data.country.size() > 0 && data.country.size() <= 120
          && data.timezone is string && data.timezone.size() > 0 && data.timezone.size() <= 100
          && data.deviceType is string && data.deviceType.size() > 0 && data.deviceType.size() <= 50
          && data.browser is string && data.browser.size() > 0 && data.browser.size() <= 80
          && (!('os' in data) || (data.os is string && data.os.size() <= 80))
          && data.createdAtIso is string && data.createdAtIso.size() > 0 && data.createdAtIso.size() <= 60;
    }

    match /users/{userId} {
      // Users can only see and manage their own profile document
      allow get: if isOwner(userId) || isAdmin();
      
      allow create: if isOwner(userId)
                    && isValidId(userId)
                    && isValidUser(incoming());

      allow update: if isOwner(userId)
                    && isValidId(userId)
                    && isValidUser(incoming());
    }

    match /user_routines/{userId} {
      // Users can only access and update their own routine progress
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidId(userId) && isValidUserRoutine(incoming());
      allow delete: if isOwner(userId);
    }

    match /messages/{messageId} {
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidMessage(incoming());
    }

    match /posts/{postId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn();
      allow create: if isSignedIn() && isValidPost(incoming());
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;

      match /replies/{replyId} {
        allow list: if isSignedIn();
        allow create: if isSignedIn() && isValidReply(incoming());
        allow delete: if isSignedIn() && existing().userId == request.auth.uid;
      }
    }

    match /milestones/{milestoneId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if isSignedIn() && isValidMilestone(incoming());
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    match /consultations/{consultationId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidConsultation(incoming());
      allow update: if isSignedIn() && isValidConsultation(incoming()) && existing().userId == request.auth.uid && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    match /site_analytics/{eventId} {
      // Only the authenticated admin can view or delete site analytics
      allow get, list, delete: if isAdmin();
      // Any authenticated session (including Guest Demo session and signed-in accounts) can log a validated visit event
      allow create: if isSignedIn() && isValidId(eventId) && isValidAnalyticsEvent(incoming());
      allow update: if isAdmin() && isValidId(eventId) && isValidAnalyticsEvent(incoming());
    }

    function incoming() {
      return request.resource.data;
    }
    function existing() {
      return resource.data;
    }

    // Test connection health check
    match /test/{docId} {
      allow read: if true;
    }

    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

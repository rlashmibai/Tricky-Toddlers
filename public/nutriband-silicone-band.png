<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 750" width="100%" height="100%">
  <defs>
    <!-- Studio Background -->
    <radialGradient id="bgGrad" cx="50%" cy="40%" r="70%">
      <stop offset="0%" stop-color="#1E293B"/>
      <stop offset="50%" stop-color="#0F172A"/>
      <stop offset="100%" stop-color="#020617"/>
    </radialGradient>

    <!-- Adult Smartwatch Case: Matte Titanium Dark Grey -->
    <linearGradient id="caseMetal" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#334155"/>
      <stop offset="30%" stop-color="#1E293B"/>
      <stop offset="70%" stop-color="#0F172A"/>
      <stop offset="100%" stop-color="#020617"/>
    </linearGradient>

    <!-- Polished Bezel Highlight Rim -->
    <linearGradient id="bezelRim" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#64748B"/>
      <stop offset="25%" stop-color="#94A3B8"/>
      <stop offset="50%" stop-color="#CBD5E1"/>
      <stop offset="75%" stop-color="#64748B"/>
      <stop offset="100%" stop-color="#1E293B"/>
    </linearGradient>

    <!-- Adult Silicone Strap Gradient (Rich Vibrant Blue) -->
    <linearGradient id="strapGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#0369A1"/>
      <stop offset="15%" stop-color="#0284C7"/>
      <stop offset="50%" stop-color="#38BDF8"/>
      <stop offset="85%" stop-color="#0284C7"/>
      <stop offset="100%" stop-color="#075985"/>
    </linearGradient>

    <!-- Glowing Heart 3D Radial Gradient -->
    <radialGradient id="heartGlow" cx="40%" cy="35%" r="65%">
      <stop offset="0%" stop-color="#FF7597"/>
      <stop offset="40%" stop-color="#FF1A53"/>
      <stop offset="85%" stop-color="#D9043D"/>
      <stop offset="100%" stop-color="#9E002B"/>
    </radialGradient>

    <!-- Ring Multi-Color Gradient (Cyan to Electric Purple) -->
    <linearGradient id="neonRingCyan" x1="0%" y1="100%" x2="0%" y2="0%">
      <stop offset="0%" stop-color="#0284C7"/>
      <stop offset="50%" stop-color="#0EA5E9"/>
      <stop offset="100%" stop-color="#38BDF8"/>
    </linearGradient>
    <linearGradient id="neonRingPurple" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#C084FC"/>
      <stop offset="50%" stop-color="#A855F7"/>
      <stop offset="100%" stop-color="#E879F9"/>
    </linearGradient>

    <!-- Drop Shadows & Glow Filters -->
    <filter id="watchShadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="16" stdDeviation="20" flood-color="#000000" flood-opacity="0.75"/>
      <feDropShadow dx="0" dy="4" stdDeviation="6" flood-color="#38BDF8" flood-opacity="0.12"/>
    </filter>

    <filter id="neonGlow" x="-30%" y="-30%" width="160%" height="160%">
      <feGaussianBlur stdDeviation="5" result="glow"/>
      <feMerge>
        <feMergeNode in="glow"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>

    <filter id="heartNeonGlow" x="-40%" y="-40%" width="180%" height="180%">
      <feGaussianBlur stdDeviation="8" result="glow"/>
      <feMerge>
        <feMergeNode in="glow"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>

    <!-- Glass Glare Diagonal Reflection -->
    <linearGradient id="glassGlare" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FFFFFF" stop-opacity="0.18"/>
      <stop offset="28%" stop-color="#FFFFFF" stop-opacity="0.04"/>
      <stop offset="100%" stop-color="#FFFFFF" stop-opacity="0.0"/>
    </linearGradient>

    <!-- White Modular Sensor Pod Material (Rear View) -->
    <linearGradient id="whitePodCasing" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FFFFFF"/>
      <stop offset="40%" stop-color="#F8FAFC"/>
      <stop offset="80%" stop-color="#E2E8F0"/>
      <stop offset="100%" stop-color="#CBD5E1"/>
    </linearGradient>
    <radialGradient id="podCoreGlow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#38BDF8" stop-opacity="0.9"/>
      <stop offset="40%" stop-color="#0284C7" stop-opacity="0.4"/>
      <stop offset="100%" stop-color="#0369A1" stop-opacity="0"/>
    </radialGradient>
  </defs>

  <!-- Background -->
  <rect width="600" height="750" fill="url(#bgGrad)"/>

  <!-- Subtle Studio Light Bloom -->
  <circle cx="270" cy="360" r="280" fill="#0284C7" opacity="0.07"/>

  <!-- =========================================================================
       1. MAIN ADULT SMARTWATCH (FRONT VIEW WITH HEALTH SENSOR DISPLAY)
       ========================================================================= -->
  <g transform="translate(10, 10)" filter="url(#watchShadow)">

    <!-- UPPER STRAP (Sleek adult matte silicone band, ribbed texture) -->
    <path d="M 195 125 L 195 20 C 195 15, 345 15, 345 20 L 345 125 Z" fill="url(#strapGrad)"/>
    <!-- Subtle strap grooves -->
    <line x1="205" y1="45" x2="335" y2="45" stroke="#BAE6FD" stroke-width="2" opacity="0.5"/>
    <line x1="205" y1="70" x2="335" y2="70" stroke="#BAE6FD" stroke-width="2" opacity="0.5"/>
    <line x1="205" y1="95" x2="335" y2="95" stroke="#BAE6FD" stroke-width="2" opacity="0.5"/>

    <!-- LOWER STRAP (Sleek adult blue silicone band with adjustment notches) -->
    <path d="M 195 560 L 195 700 C 195 715, 345 715, 345 700 L 345 560 Z" fill="url(#strapGrad)"/>
    <!-- Adjustment notches along lower strap -->
    <g fill="#082F49" opacity="0.6">
      <rect x="264" y="590" width="12" height="20" rx="6"/>
      <rect x="264" y="625" width="12" height="20" rx="6"/>
      <rect x="264" y="660" width="12" height="20" rx="6"/>
    </g>

    <!-- MAIN ADULT WATCH BODY (Rounded Rectangular Metal Bezel) -->
    <!-- Metal chassis bevel -->
    <rect x="135" y="95" width="270" height="495" rx="62" fill="url(#caseMetal)" stroke="url(#bezelRim)" stroke-width="3"/>
    
    <!-- Right side rotary crown button -->
    <rect x="403" y="195" width="12" height="42" rx="4" fill="#64748B" stroke="#334155" stroke-width="1.5"/>
    <!-- Right side lower sensor/button -->
    <rect x="403" y="275" width="8" height="32" rx="3" fill="#475569" stroke="#1E293B" stroke-width="1.5"/>

    <!-- Left side microphone / speaker vents -->
    <rect x="127" y="235" width="8" height="30" rx="3" fill="#334155"/>

    <!-- INNER BEZEL (Deep polished black edge) -->
    <rect x="146" y="106" width="248" height="473" rx="52" fill="#030712" stroke="#1E293B" stroke-width="2"/>

    <!-- =========================================================================
         EXACT ON-SCREEN HEALTH SENSOR DISPLAY (MIRRORING USER'S REFERENCE IMAGE)
         ========================================================================= -->
    <!-- OLED Screen Surface -->
    <rect x="150" y="110" width="240" height="465" rx="48" fill="#000000"/>

    <!-- Camera / Optical Sensor Notch at top center -->
    <circle cx="270" cy="126" r="8" fill="#0F172A" stroke="#1E293B" stroke-width="1.5"/>
    <circle cx="270" cy="126" r="4" fill="#0284C7" opacity="0.8"/>
    <circle cx="268.5" cy="124.5" r="1.5" fill="#FFFFFF" opacity="0.9"/>

    <!-- Time: "09:26" in large bold white font -->
    <text x="270" y="190" 
          font-family="system-ui, -apple-system, sans-serif" 
          font-size="46" font-weight="900" 
          fill="#FFFFFF" text-anchor="middle" letter-spacing="1">09:26</text>

    <!-- Date: "04/06 Wed" -->
    <text x="270" y="218" 
          font-family="system-ui, -apple-system, sans-serif" 
          font-size="19" font-weight="600" 
          fill="#FFFFFF" text-anchor="middle" opacity="0.95" letter-spacing="0.5">04/06 Wed</text>

    <!-- CENTER GRAPHIC: GLOWING MULTI-COLOR NEON RING + 3D HEART + ECG PULSE -->
    <g transform="translate(270, 320)">
      <!-- Outer cyan-blue arc (9 o'clock down to 3 o'clock) -->
      <path d="M -75 0 A 75 75 0 0 0 75 0" 
            fill="none" stroke="url(#neonRingCyan)" stroke-width="9" stroke-linecap="round" filter="url(#neonGlow)"/>
      <!-- Small bright cyan tick on arc -->
      <circle cx="-53" cy="-53" r="4.5" fill="#FFFFFF"/>

      <!-- Outer purple-magenta arc (3 o'clock up to 9 o'clock) -->
      <path d="M 75 0 A 75 75 0 0 0 -75 0" 
            fill="none" stroke="url(#neonRingPurple)" stroke-width="9" stroke-linecap="round" filter="url(#neonGlow)"/>
      <!-- Small bright purple segment on arc -->
      <path d="M 62 42 A 75 75 0 0 0 74 15" fill="none" stroke="#F43F5E" stroke-width="9" stroke-linecap="round"/>

      <!-- RADIANT 3D GLOWING HEART -->
      <g filter="url(#heartNeonGlow)">
        <!-- Heart Path (Smooth 3D shape) -->
        <path d="M 0 35 C -45 5, -60 -25, -30 -42 C -10 -50, 0 -22, 0 -20 C 0 -22, 10 -50, 30 -42 C 60 -25, 45 5, 0 35 Z" 
              fill="url(#heartGlow)"/>
        <!-- Soft top specular highlight on heart lobes -->
        <ellipse cx="-20" cy="-28" rx="8" ry="4" fill="#FFFFFF" opacity="0.45" transform="rotate(-25, -20, -28)"/>
        <ellipse cx="20" cy="-28" rx="8" ry="4" fill="#FFFFFF" opacity="0.45" transform="rotate(25, 20, -28)"/>

        <!-- ECG Heartbeat Pulse Line across the heart -->
        <path d="M -50 -2 L -20 -2 L -12 -2 L -5 -24 L 2 18 L 8 -12 L 14 -2 L 50 -2" 
              fill="none" stroke="#FFFFFF" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round"/>
      </g>
    </g>

    <!-- Subtitle: "Health Sensor" -->
    <text x="270" y="425" 
          font-family="system-ui, -apple-system, sans-serif" 
          font-size="20" font-weight="700" 
          fill="#FFFFFF" text-anchor="middle" letter-spacing="0.5">Health Sensor</text>

    <!-- BOTTOM ROW: 4 GLOWING CIRCULAR HEALTH METRICS -->
    <g transform="translate(162, 455)">
      <!-- 1. Heart Rate (Red circle with heart) -->
      <g transform="translate(25, 25)">
        <circle cx="0" cy="0" r="22" fill="#0B132B" stroke="#EF4444" stroke-width="3" filter="url(#neonGlow)"/>
        <path d="M 0 8 C -9 2, -12 -5, -6 -9 C -2 -11, 0 -5, 0 -4 C 0 -5, 2 -11, 6 -9 C 12 -5, 9 2, 0 8 Z" fill="#EF4444"/>
      </g>

      <!-- 2. Blood Oxygen SpO2 (Cyan-blue circle with O2 droplet) -->
      <g transform="translate(80, 25)">
        <circle cx="0" cy="0" r="22" fill="#0B132B" stroke="#06B6D4" stroke-width="3" filter="url(#neonGlow)"/>
        <!-- Droplet -->
        <path d="M 0 -9 C 5 -3, 7 1, 7 5 C 7 9, 3.5 12, 0 12 C -3.5 12, -7 9, -7 5 C -7 1, -5 -3, 0 -9 Z" fill="#06B6D4" opacity="0.6"/>
        <!-- Text: O2 -->
        <text x="0" y="7" font-family="system-ui, -apple-system, sans-serif" font-size="11" font-weight="900" fill="#FFFFFF" text-anchor="middle">O₂</text>
      </g>

      <!-- 3. Sleep Tracking (Purple circle with crescent moon & stars) -->
      <g transform="translate(135, 25)">
        <circle cx="0" cy="0" r="22" fill="#0B132B" stroke="#A855F7" stroke-width="3" filter="url(#neonGlow)"/>
        <!-- Crescent Moon -->
        <path d="M 2 -8 C -4 -7, -8 -2, -8 4 C -8 10, -2 13, 4 12 C 1 10, 0 6, 1 2 C 2 -2, 5 -6, 8 -7 C 6 -8, 4 -8, 2 -8 Z" fill="#A855F7"/>
        <!-- Small Star -->
        <circle cx="5" cy="-2" r="1.5" fill="#FFFFFF"/>
        <circle cx="8" cy="4" r="1.2" fill="#C084FC"/>
      </g>

      <!-- 4. Respiration / Breathing (Green circle with lungs) -->
      <g transform="translate(190, 25)">
        <circle cx="0" cy="0" r="22" fill="#0B132B" stroke="#10B981" stroke-width="3" filter="url(#neonGlow)"/>
        <!-- Stylized Lungs Icon -->
        <g fill="#10B981" stroke="#10B981" stroke-width="1.2" stroke-linecap="round">
          <!-- Trachea -->
          <line x1="0" y1="-8" x2="0" y2="-2" stroke="#FFFFFF" stroke-width="1.8"/>
          <!-- Left lung -->
          <path d="M -1 -1 C -5 -1, -8 3, -8 7 C -8 11, -3 12, -1 10 Z"/>
          <!-- Right lung -->
          <path d="M 1 -1 C 5 -1, 8 3, 8 7 C 8 11, 3 12, 1 10 Z"/>
        </g>
      </g>
    </g>

    <!-- Diagonal Glass Specular Reflection Highlight -->
    <path d="M 152 112 L 340 112 C 375 112, 388 126, 388 155 L 152 350 Z" fill="url(#glassGlare)"/>
  </g>

  <!-- =========================================================================
       2. REAR INSET CALLOUT: SMALL WHITE MODULAR SENSOR POD DOCKED IN BACK
       ========================================================================= -->
  <g transform="translate(425, 470)" filter="url(#watchShadow)">
    <!-- Connecting Leader Line from Watch Case -->
    <path d="M -50 0 C -25 0, -15 35, 10 35" fill="none" stroke="#38BDF8" stroke-width="2.5" stroke-dasharray="4 3"/>

    <!-- Inset Frame Backdrop -->
    <rect x="-10" y="-12" width="165" height="215" rx="20" fill="#0B1329" stroke="#38BDF8" stroke-width="2"/>
    
    <!-- Top Pill Badge -->
    <rect x="5" y="-1" width="135" height="22" rx="11" fill="#0284C7"/>
    <text x="72" y="14" font-family="system-ui, -apple-system, sans-serif" font-size="10" font-weight="900" fill="#FFFFFF" text-anchor="middle" letter-spacing="0.5">BACK DOCK VIEW</text>

    <!-- Smartwatch Back Chassis Section -->
    <rect x="15" y="30" width="115" height="115" rx="28" fill="#1E293B" stroke="#334155" stroke-width="2"/>
    <circle cx="72" cy="87" r="44" fill="#0F172A" stroke="#475569" stroke-width="2"/>

    <!-- THE WHITE MODULAR SENSOR POD DOCKED INTO THE BACK -->
    <g transform="translate(72, 87)">
      <!-- Outer White Polymer Bevel -->
      <circle cx="0" cy="0" r="38" fill="url(#whitePodCasing)" stroke="#E2E8F0" stroke-width="2"/>
      
      <!-- Inner Optical Sensor Window -->
      <circle cx="0" cy="0" r="22" fill="#030712" stroke="#CBD5E1" stroke-width="1.8"/>
      <circle cx="0" cy="0" r="16" fill="url(#podCoreGlow)"/>

      <!-- Center Dual Optical Biosensor LEDs (Green / Red PPG & Temp) -->
      <rect x="-7" y="-3.5" width="5" height="7" rx="1.5" fill="#22C55E"/>
      <rect x="2" y="-3.5" width="5" height="7" rx="1.5" fill="#EF4444"/>

      <!-- Dual Gold Pogo Charging Contacts -->
      <circle cx="0" cy="-29" r="3.2" fill="#EAB308" stroke="#CA8A04" stroke-width="1"/>
      <circle cx="0" cy="29" r="3.2" fill="#EAB308" stroke="#CA8A04" stroke-width="1"/>
    </g>

    <!-- Explanatory Labels -->
    <text x="72" y="162" font-family="system-ui, -apple-system, sans-serif" font-size="11" font-weight="900" fill="#38BDF8" text-anchor="middle">White Sensor Pod</text>
    <text x="72" y="180" font-family="system-ui, -apple-system, sans-serif" font-size="9" font-weight="600" fill="#94A3B8" text-anchor="middle">Clicks inside rear dock</text>
    <text x="72" y="195" font-family="system-ui, -apple-system, sans-serif" font-size="9" font-weight="600" fill="#94A3B8" text-anchor="middle">Skin-contact thermistor</text>
  </g>
</svg>
{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User specific profile information.",
      "type": "object",
      "properties": {
        "username": {
          "type": "string",
          "description": "Unique username"
        },
        "firstName": {
          "type": "string",
          "description": "User's first name"
        },
        "lastName": {
          "type": "string",
          "description": "User's last name"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last time the profile was updated"
        }
      },
      "required": ["username"]
    },
    "Message": {
      "title": "Chat Message",
      "description": "A message in a 1:1 or global chat.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "username": { "type": "string" },
        "receiverName": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "username", "text", "createdAt"]
    },
    "Post": {
      "title": "Community Post",
      "description": "A community help request posted by a user.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "username": { "type": "string" },
        "content": { "type": "string" },
        "hashtags": { "type": "array", "items": { "type": "string" } },
        "attachments": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "username", "content", "createdAt"]
    },
    "Reply": {
      "title": "Post Reply",
      "description": "A reply to a community post.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "username": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "username", "content", "createdAt"]
    },
    "Milestone": {
      "title": "Baby Milestone Log",
      "description": "An infant/toddler developmental milestone achievement logged by their parent.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "The UID of the parent who logged this" },
        "milestoneId": { "type": "string", "description": "ID of the milestone (e.g. crawling)" },
        "achievedAge": { "type": "number", "description": "The baby's age in months when achieved" },
        "achievedDate": { "type": "string", "description": "Approximate calendar date achieved" },
        "notes": { "type": "string", "description": "Sweet memories or descriptions added by parents" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last saved timestamp" }
      },
      "required": ["userId", "milestoneId", "achievedAge", "achievedDate", "updatedAt"]
    },
    "Consultation": {
      "title": "Pediatric Consultation Booking",
      "description": "A consultation booked by a parent with a verified pediatrician.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "The UID of the parent who booked this" },
        "doctorName": { "type": "string", "description": "Name of the pediatrician" },
        "specialty": { "type": "string", "description": "Specialty of the pediatrician" },
        "city": { "type": "string", "description": "Selected city" },
        "clinic": { "type": "string", "description": "Selected clinic name" },
        "date": { "type": "string", "description": "Preferred date" },
        "time": { "type": "string", "description": "Preferred time" },
        "status": { "type": "string", "description": "Booking status" },
        "createdAt": { "type": "string", "format": "date-time", "description": "When booking was created" }
      },
      "required": ["userId", "doctorName", "specialty", "city", "clinic", "date", "time", "status", "createdAt"]
    },
    "UserRoutine": {
      "title": "User Routine Progress",
      "description": "The tracked checklist items and routines for a user.",
      "type": "object",
      "properties": {
        "completedIds": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Array of routine item IDs completed by the user"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last updated timestamp"
        }
      }
    },
    "AnalyticsEvent": {
      "title": "Site Analytics Event",
      "description": "Tracks guest account clicks, user logins, login times, days of the week, locations, and personas explored.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID of the session" },
        "visitorId": { "type": "string", "description": "Anonymous visitor identifier for unique vs returning tracking" },
        "isReturningVisitor": { "type": "boolean", "description": "Whether this visitor has used the app previously" },
        "accountType": { "type": "string", "description": "Guest Account or Personal Account" },
        "entryPoint": { "type": "string", "description": "Button or flow that triggered the session" },
        "personaName": { "type": "string", "description": "Parent persona name (e.g. Parent)" },
        "childProfile": { "type": "string", "description": "Active child profile (e.g. Child 1, Child 2, General)" },
        "activeTab": { "type": "string", "description": "Feature tab opened" },
        "loginDate": { "type": "string", "description": "YYYY-MM-DD date string" },
        "dayOfWeek": { "type": "string", "description": "Day of week (e.g. Monday)" },
        "loginTime": { "type": "string", "description": "Formatted local login time" },
        "timeOfDaySlot": { "type": "string", "description": "Morning, Afternoon, Evening, or Night" },
        "city": { "type": "string", "description": "Detected or profile city" },
        "region": { "type": "string", "description": "Detected or profile state/region" },
        "country": { "type": "string", "description": "Detected country" },
        "timezone": { "type": "string", "description": "Browser IANA timezone" },
        "deviceType": { "type": "string", "description": "Desktop, Mobile, or Tablet" },
        "browser": { "type": "string", "description": "Browser name" },
        "os": { "type": "string", "description": "Operating system" },
        "createdAtIso": { "type": "string", "description": "ISO timestamp string" }
      },
      "required": [
        "userId",
        "visitorId",
        "isReturningVisitor",
        "accountType",
        "entryPoint",
        "personaName",
        "childProfile",
        "loginDate",
        "dayOfWeek",
        "loginTime",
        "timeOfDaySlot",
        "city",
        "region",
        "country",
        "timezone",
        "deviceType",
        "browser",
        "createdAtIso"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "A collection of user profiles keyed by their authentication UID."
    },
    "/user_routines/{userId}": {
      "schema": "UserRoutine",
      "description": "Tracked routine checklist state for a parent keyed by their authentication UID."
    },
    "/messages/{messageId}": {
      "schema": "Message",
      "description": "A collection of real-time messages for the global chat."
    },
    "/posts/{postId}": {
      "schema": "Post",
      "description": "A collection of community help requests."
    },
    "/posts/{postId}/replies/{replyId}": {
      "schema": "Reply",
      "description": "A collection of replies to a specific community post."
    },
    "/milestones/{milestoneId}": {
      "schema": "Milestone",
      "description": "A collection of logged infant/toddler milestones."
    },
    "/consultations/{consultationId}": {
      "schema": "Consultation",
      "description": "A collection of booked pediatrician consultations."
    },
    "/site_analytics/{eventId}": {
      "schema": "AnalyticsEvent",
      "description": "Site analytics events tracking guest logins, timestamps, and geographic locations, readable only by the admin."
    }
  }
}
